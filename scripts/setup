#!/usr/bin/env bash
set -euo pipefail

echo "==> shards install"
shards install

if command -v crystalline >/dev/null 2>&1; then
  echo "==> crystalline already installed: $(command -v crystalline)"
  exit 0
fi

echo "==> installing crystalline (LSP)"
if command -v brew >/dev/null 2>&1; then
  brew install crystalline
elif command -v yay >/dev/null 2>&1; then
  yay -S --noconfirm crystalline
else
  echo "Install manually: https://github.com/elbywan/crystalline/releases"
  exit 1
fi
